    local function syncProperties()
        local fSize = math.clamp(fireObj.Size, 2, 30)
        local fHeat = math.clamp(fireObj.Heat, 2, 30)
        local visualSize = fSize * 0.7
        
        fireParticle.Rate = math.clamp(fSize * 4, 25, 70) 
        fireParticle.SpreadAngle = Vector2.new(4 + (fHeat * 0.25), 4 + (fHeat * 0.25))
        fireParticle.Speed = NumberRange.new(fHeat * 0.4, fHeat * 0.7)
