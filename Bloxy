local menuOpenState = false
local currentTween = nil

local function setMenuState(targetState)
	if menuOpenState == targetState then return end
	menuOpenState = targetState
	
	local targetHeight = menuOpenState and 180 or 0
	local iconLabel = menuToggleBtn:FindFirstChild("Icon")
	
	if menuOpenState then
		dropdownFrame.Visible = true
		if iconLabel then iconLabel.Image = MORE_CLOSE_ICON end
	else
		if iconLabel then iconLabel.Image = MORE_OPEN_ICON end
	end
	
	if currentTween then
		currentTween:Cancel()
	end
	
	local tInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	currentTween = TweenService:Create(dropdownFrame, tInfo, {Size = UDim2.new(0, 240, 0, targetHeight)})
	currentTween:Play()
	
	if not menuOpenState then
		currentTween.Completed:Connect(function()
			if not menuOpenState then
				dropdownFrame.Visible = false
			end
		end)
	end
	
	-- Restored playerlist collapse logic --
	if isHidden then return end
	isCollapsed = not isCollapsed
	local fullWidth = calculateContainerWidth()
	local targetWidth = isCollapsed and 150 or fullWidth
	
	closeCard()
	
	TweenService:Create(container, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, targetWidth, 0, 300),
		Position = UDim2.new(1, -(targetWidth + 5), 0, 0)
	}):Play()

	for _, child in ipairs(container:GetDescendants()) do
		if child:IsA("TextLabel") then
			TweenService:Create(child, TweenInfo.new(0.2), {
				TextTransparency = isCollapsed and 1 or (child.Name:match("^Players_") and 0 or 0.2)
			}):Play()
		elseif child:IsA("Frame") and child.Name:match("^Players_") then
			TweenService:Create(child, TweenInfo.new(0.25), {
				BackgroundTransparency = isCollapsed and 0.8 or (child.Name == "Players_TeamHeader" and 0.2 or 0.5)
			}):Play()
		end
	end
end

