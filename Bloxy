local function updateHealthBar()
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local hp = math.clamp(humanoid.Health, 0, humanoid.MaxHealth)
		local maxHp = math.max(humanoid.MaxHealth, 1)
		local ratio = hp / maxHp
		
		healthFill.Size = UDim2.new(ratio, 0, 1, 0)
		
		if hp <= 0 then
			healthBarFrame.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
			healthFill.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
		else
			healthBarFrame.BackgroundColor3 = Color3.fromRGB(31, 33, 37)
			if ratio > 0.5 then
				local t = (ratio - 0.5) / 0.5
				healthFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0):Lerp(Color3.fromRGB(40, 200, 40), t)
			else
				local t = ratio / 0.5
				healthFill.BackgroundColor3 = Color3.fromRGB(220, 40, 40):Lerp(Color3.fromRGB(255, 200, 0), t)
			end
		end
	end
end

