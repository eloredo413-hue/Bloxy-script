	TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	TextLabel.TextXAlignment = Enum.TextXAlignment.Left
	TextLabel.TextYAlignment = Enum.TextYAlignment.Center
	TextLabel.RichText = true
	TextLabel.Text = string.format(' <font color="%s">%s</font>: %s ', colorHex, senderName, messageText)
	TextLabel.Parent = MsgFrame

	local offset = 6
	local padding = 20
	local totalWidth = math.max(100, TextLabel.TextBounds.X + offset + padding + 8)
	
	TextLabel.Position = UDim2.new(0, offset, 0, 0)
	TextLabel.Size = UDim2.new(1, -offset, 1, 0)
	MsgFrame.Size = UDim2.new(0, totalWidth, 0, 22)
	MsgFrame.Position = UDim2.new(0, 0, 0, 0)
	
	-- REMOVED: No more tweening or task.delay out! Messages stay visible forever.
end

