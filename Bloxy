-- Function to manage TinyRow visibility (hides divider on the last player of each group)
local function updateDividers()
	local allChildren = container:GetChildren()
	
	-- Filter only GUI objects (Frames, TextButtons, etc.) to avoid errors with UIListLayout
	local guiChildren = {}
	for _, child in ipairs(allChildren) do
		if child:IsA("GuiObject") then
			table.insert(guiChildren, child)
		end
	end

	-- Sort by LayoutOrder safely
	table.sort(guiChildren, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)

	local playerButtons = {}
	for _, child in ipairs(guiChildren) do
		if child:IsA("TextButton") and child.Name:sub(1, 8) == "Players_" then
			table.insert(playerButtons, child)
		end
	end

	for i, btn in ipairs(playerButtons) do
		local tinyRow = btn:FindFirstChild("TinyRow")
		if tinyRow then
			local isLastInList = (i == #playerButtons)
			
			local nextItemIsTeamHeader = false
			if not isLastInList then
				local currentIdx = table.find(guiChildren, btn)
				if currentIdx and guiChildren[currentIdx + 1] then
					local nextChild = guiChildren[currentIdx + 1]
					if nextChild.Name == "Players_TeamHeader" then
						nextItemIsTeamHeader = true
					end
				end
			end

			tinyRow.Visible = not (isLastInList or nextItemIsTeamHeader)
		end
	end
end

