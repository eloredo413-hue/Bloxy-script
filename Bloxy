            NumberSequenceKeypoint.new(0.6, 0.2),   
            NumberSequenceKeypoint.new(1, 1)         
        })

        fireParticle.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, fireObj.Color),
            ColorSequenceKeypoint.new(1, fireObj.SecondaryColor)
        })
    end

